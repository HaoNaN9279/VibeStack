{
  "name": "dsh-vibestack",
  "version": "0.5.0",
  "private": true,
  "description": "VibeStack capability groups as a DeepSeek Harness mode",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "repair-sessions": "node scripts/repair-session-events.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "scripts/",
    "cordis.patch.yml",
    "skills/"
  ],
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": []
    }
  }
}
