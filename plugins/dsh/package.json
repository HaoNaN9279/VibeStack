{
  "name": "dsh-vibestack",
  "version": "0.1.0",
  "description": "VibeStack capability groups as a DeepSeek Harness mode",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoNaN9279/VibeStack.git",
    "directory": "plugins/dsh"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "skills/",
    "plugin.json",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": []
    }
  }
}
